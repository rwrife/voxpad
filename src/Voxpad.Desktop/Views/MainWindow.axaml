<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Voxpad.Desktop.ViewModels"
        x:Class="Voxpad.Desktop.Views.MainWindow"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        Title="voxpad — Model Manager">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock FontSize="22"
                 FontWeight="SemiBold"
                 Text="Models" />
      <TextBlock TextWrapping="Wrap"
                 Text="Download, select, and remove local whisper.cpp models. The first run recommends downloading base for balanced speed and quality." />

      <Border Background="#1E3A8A22"
              BorderBrush="#1E3A8A"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10"
              IsVisible="{Binding ModelManager.HasFirstRunGuidance}">
        <TextBlock TextWrapping="Wrap"
                   Text="{Binding ModelManager.FirstRunGuidance}" />
      </Border>

      <TextBlock Foreground="#B91C1C"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ModelManager.HasStatusMessage}"
                 Text="{Binding ModelManager.StatusMessage}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh"
                Command="{Binding ModelManager.RefreshCommand}" />
        <TextBlock VerticalAlignment="Center"
                   IsVisible="{Binding ModelManager.IsRefreshing}"
                   Text="Refreshing…" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Margin="0,16,0,0"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ModelManager.Models}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="3*,Auto,Auto,2*">
                  <TextBlock Grid.Column="0"
                             FontWeight="SemiBold"
                             Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Language}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding SizeLabel}" />
                  <TextBlock Grid.Column="3"
                             HorizontalAlignment="Right"
                             Text="{Binding StatusText}" />
                </Grid>

                <Grid ColumnDefinitions="3*,Auto"
                      IsVisible="{Binding IsBusy}">
                  <ProgressBar Grid.Column="0"
                               Minimum="0"
                               Maximum="1"
                               Value="{Binding DownloadProgress}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding DownloadPercentLabel}" />
                </Grid>

                <WrapPanel ItemWidth="120"
                           Orientation="Horizontal">
                  <Button Margin="0,0,8,0"
                          Content="Download"
                          IsEnabled="{Binding CanDownload}"
                          Command="{Binding DownloadCommand}" />
                  <Button Margin="0,0,8,0"
                          Content="Cancel"
                          IsEnabled="{Binding CanCancel}"
                          Command="{Binding CancelCommand}" />
                  <Button Margin="0,0,8,0"
                          Content="Select"
                          IsEnabled="{Binding CanSelect}"
                          Command="{Binding SelectCommand}" />
                  <Button Content="Delete"
                          IsEnabled="{Binding CanDelete}"
                          Command="{Binding DeleteCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
