<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Voxpad.Desktop.ViewModels"
        x:Class="Voxpad.Desktop.Views.MainWindow"
        Width="1120"
        Height="760"
        MinWidth="820"
        MinHeight="580"
        Title="voxpad — Pipeline Studio">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <TabControl Margin="16">
    <TabItem Header="Pipeline Studio">
      <Grid Margin="0,12,0,0"
            RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Text="Pipeline Studio" />
          <TextBlock TextWrapping="Wrap"
                     Text="Edit the source transcript, choose optional local stages, and keep every generated variant and artifact non-destructive." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,8"
                Padding="10"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <StackPanel Grid.Column="0" Margin="0,0,18,0" Spacing="4">
              <CheckBox Content="Cleanup"
                        IsChecked="{Binding PostProcessing.CleanupEnabled}" />
              <TextBlock FontSize="11" Text="{Binding PostProcessing.CleanupStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,18,0" Spacing="4">
              <CheckBox Content="Translation"
                        IsChecked="{Binding PostProcessing.TranslationEnabled}" />
              <TextBlock FontSize="11" Text="{Binding PostProcessing.TranslationStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,18,0" Spacing="4">
              <CheckBox Content="Re-voice"
                        IsChecked="{Binding PostProcessing.VoiceEnabled}" />
              <TextBlock FontSize="11" Text="{Binding PostProcessing.VoiceStatus}" />
            </StackPanel>
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding PostProcessing.PipelineStatus}" />
            <Button Grid.Column="4"
                    Content="Run enabled stages"
                    IsEnabled="{Binding PostProcessing.IsNotBusy}"
                    Command="{Binding PostProcessing.RunPipelineCommand}" />
          </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,12"
              ColumnDefinitions="180,180,180,Auto,*">
          <TextBox Grid.Column="0"
                   Margin="0,0,8,0"
                   Watermark="Languages: es, fr"
                   Text="{Binding PostProcessing.TargetLanguages}" />
          <TextBox Grid.Column="1"
                   Margin="0,0,8,0"
                   Watermark="Voice profile"
                   Text="{Binding PostProcessing.VoiceProfileName}" />
          <TextBox Grid.Column="2"
                   Margin="0,0,8,0"
                   Watermark="Voice ID"
                   Text="{Binding PostProcessing.VoiceId}" />
          <Button Grid.Column="3"
                  Margin="0,0,8,0"
                  Content="Retry last"
                  IsEnabled="{Binding PostProcessing.IsNotBusy}"
                  Command="{Binding PostProcessing.RetryCommand}" />
          <StackPanel Grid.Column="4"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Promote selected"
                    IsEnabled="{Binding PostProcessing.IsNotBusy}"
                    Command="{Binding PostProcessing.PromoteCommand}" />
            <Button Content="Restore source"
                    IsEnabled="{Binding PostProcessing.IsNotBusy}"
                    Command="{Binding PostProcessing.RevertCommand}" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="10"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
            <Button Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Content="Open media…"
                    Click="OpenMedia_Click" />
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{Binding Media.MediaName}" />
              <TextBlock FontSize="11" Text="{Binding Media.PlaybackAvailability}" />
            </StackPanel>
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    Content="{Binding Media.PlayPauseLabel}"
                    IsEnabled="{Binding Media.IsPlaybackAvailable}"
                    Command="{Binding Media.TogglePlaybackCommand}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="3"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       Text="{Binding Media.PlaybackStateLabel}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       FontFamily="Consolas,Menlo,monospace"
                       Text="{Binding Media.PositionLabel}" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="5"
                       Margin="0,8,0,0"
                       Foreground="#B91C1C"
                       IsVisible="{Binding Media.HasError}"
                       TextWrapping="Wrap"
                       Text="{Binding Media.ErrorMessage}" />
          </Grid>
        </Border>

        <Grid Grid.Row="4"
              ColumnDefinitions="*,16,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         FontWeight="SemiBold"
                         Text="Source transcript" />
              <TextBlock Grid.Column="1"
                         FontSize="11"
                         IsVisible="{Binding Media.HasUnsavedChanges}"
                         Text="Unsaved segment edits" />
            </Grid>
            <TabControl Grid.Row="1">
              <TabItem Header="Timestamped segments">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Media.Segments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="6">
                          <Grid ColumnDefinitions="105,105,*">
                            <Button Grid.Column="0"
                                    Margin="0,0,8,0"
                                    HorizontalContentAlignment="Left"
                                    Content="{Binding StartLabel}"
                                    Click="SeekSegment_Click" />
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas,Menlo,monospace"
                                       Text="{Binding EndLabel}" />
                            <TextBox Grid.Column="2"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding Text}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Plain text fallback">
                <TextBox AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Watermark="Paste transcript text here…"
                         Text="{Binding PostProcessing.SourceText}" />
              </TabItem>
            </TabControl>
          </Grid>

          <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0"
                  Margin="0,0,0,6"
                  ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Text="Generated variant" />
              <ComboBox Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding PostProcessing.Variants}"
                        SelectedItem="{Binding PostProcessing.SelectedVariant}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Border Grid.Row="1"
                    Margin="0,0,0,6"
                    Padding="8"
                    Background="#0F3B82F6"
                    CornerRadius="6">
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding PostProcessing.SelectedProvenance}" />
            </Border>
            <TextBox Grid.Row="2"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Watermark="Cleanup and translation outputs appear here."
                     Text="{Binding PostProcessing.SelectedOutputText}" />
          </Grid>
        </Grid>

        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="Generated artifacts" />
              <ItemsControl ItemsSource="{Binding PostProcessing.Artifacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FileName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Width="300" Spacing="6">
              <TextBox Watermark="Output directory"
                       Text="{Binding PostProcessing.OutputDirectory}" />
              <Button HorizontalAlignment="Right"
                      Content="Export artifacts"
                      Command="{Binding PostProcessing.ExportArtifactsCommand}" />
            </StackPanel>
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Text="{Binding PostProcessing.ExportStatus}" />
          </Grid>
        </Border>

        <Border Grid.Row="6"
                Margin="0,12,0,0"
                Padding="10"
                Background="#22B91C1C"
                BorderBrush="#B91C1C"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding PostProcessing.HasError}">
          <TextBlock Foreground="#B91C1C"
                     TextWrapping="Wrap"
                     Text="{Binding PostProcessing.ErrorMessage}" />
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Models">
      <DockPanel Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Text="Models" />
          <TextBlock TextWrapping="Wrap"
                     Text="Download, select, and remove local whisper.cpp models. The first run recommends downloading base for balanced speed and quality." />

          <Border Background="#1E3A8A22"
                  BorderBrush="#1E3A8A"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  IsVisible="{Binding ModelManager.HasFirstRunGuidance}">
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding ModelManager.FirstRunGuidance}" />
          </Border>

          <TextBlock Foreground="#B91C1C"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ModelManager.HasStatusMessage}"
                     Text="{Binding ModelManager.StatusMessage}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh"
                    Command="{Binding ModelManager.RefreshCommand}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding ModelManager.IsRefreshing}"
                       Text="Refreshing…" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ModelManager.Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="3*,Auto,Auto,2*">
                      <TextBlock Grid.Column="0"
                                 FontWeight="SemiBold"
                                 Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Language}" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding SizeLabel}" />
                      <TextBlock Grid.Column="3"
                                 HorizontalAlignment="Right"
                                 Text="{Binding StatusText}" />
                    </Grid>

                    <Grid ColumnDefinitions="3*,Auto"
                          IsVisible="{Binding IsBusy}">
                      <ProgressBar Grid.Column="0"
                                   Minimum="0"
                                   Maximum="1"
                                   Value="{Binding DownloadProgress}" />
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Text="{Binding DownloadPercentLabel}" />
                    </Grid>

                    <WrapPanel ItemWidth="120"
                               Orientation="Horizontal">
                      <Button Margin="0,0,8,0"
                              Content="Download"
                              IsEnabled="{Binding CanDownload}"
                              Command="{Binding DownloadCommand}" />
                      <Button Margin="0,0,8,0"
                              Content="Cancel"
                              IsEnabled="{Binding CanCancel}"
                              Command="{Binding CancelCommand}" />
                      <Button Margin="0,0,8,0"
                              Content="Select"
                              IsEnabled="{Binding CanSelect}"
                              Command="{Binding SelectCommand}" />
                      <Button Content="Delete"
                              IsEnabled="{Binding CanDelete}"
                              Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </TabItem>
  </TabControl>
</Window>
